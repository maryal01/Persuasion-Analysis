#!/bin/bash
# FILENAME: train.sub
# Slurm job for fine-tuning on Purdue's Gilbreth cluster. Submit from the repo root:
#   sbatch -A <account> jobs/train.sub cmv
#   sbatch -A <account> jobs/train.sub ddo_switch --push
#   sbatch -A <account> -q normal -t 12:00:00 jobs/train.sub cmv   # if your account owns GPUs
# Everything after the config name is passed through to scripts/train_delta.py.
# Run `slist` to see your accounts; standby (max 4h) works with any account.
#
# One-time setup on a login node (RCAC asks for the conda module, not anaconda):
#   module load conda
#   conda create -y -p $RCAC_SCRATCH/persuasion-env python=3.12
#   $RCAC_SCRATCH/persuasion-env/bin/pip install -r requirements.txt
#
# Runs longer than one job: queue several parts up front. Each waits for the previous one
# to end (afterany, since a time-limit kill counts as a failure), resumes from its last
# checkpoint, and parts left over after training finishes exit immediately:
#   jid=$(sbatch --parsable -A <account> jobs/train.sub ddo_switch)
#   for i in 1 2 3; do jid=$(sbatch --parsable -A <account> --dependency=afterany:$jid jobs/train.sub ddo_switch); done
# If a part crashes, the remaining parts exit immediately too; fix the cause, delete
# outputs/<config>/FAILED, and resubmit. To start a config over, delete outputs/<config>/.
#SBATCH --job-name=persuasion
#SBATCH --partition=a100-80gb
#SBATCH --qos=standby
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --output=%x-%j.out

set -euo pipefail

CONFIG=${1:-cmv}
shift || true

# Which script trains this name. t3_profiles is the T3 stance model (scripts/t3/train.py, which writes
# to outputs/t3_profiles/); every other name is a dataset config of scripts/train_delta.py.
#   sbatch -A <account> jobs/train.sub t3_profiles --bf16 --push
# t3_profiles_infer runs that model over every user with text (scripts/t3/infer_profiles.py):
#   sbatch -A <account> jobs/train.sub t3_profiles_infer --bf16 --push
if [[ $CONFIG == t3_profiles ]]; then
    TRAIN=(scripts/t3/train.py)
elif [[ $CONFIG == t3_profiles_infer ]]; then
    TRAIN=(scripts/t3/infer_profiles.py)
else
    TRAIN=(scripts/train_delta.py --dataset-config "$CONFIG")
fi

# Markers for chained parts; smoke runs never set or check them.
#   DONE:   a full run finished, so later parts have nothing to do.
#   FAILED: a part crashed, so later parts would fail the same way while holding a GPU.
# A time-limit kill or scancel ends this script outright, so it sets neither.
# A text + audience run (--audience <source>) has its own outputs and markers, named as in
# scripts/train_delta.py: outputs/<config>-audience-<source>/. A run with the voter's voting record
# (--voter-record <kind>) has -record-<kind> after that, and a run with another seed than 42
# (--seed <N>) has -seed<N> at the end. A run on the temporal split (--split temporal) has -temporal
# right after the config, and a run with another token limit than 4096 (--max-length <N>, the
# MAX_LENGTH of scripts/train_delta.py) has -len<N> before the seed. An --eval-only run scores a finished
# model, so like a smoke run it neither checks nor sets the markers.
#   sbatch -A <account> jobs/train.sub ddo_switch --audience self --bf16 --push
#   sbatch -A <account> jobs/train.sub ddo_switch --audience self --seed 43 --bf16 --push
#   sbatch -A <account> jobs/train.sub ddo_switch --voter-record all --bf16 --push
#   sbatch -A <account> jobs/train.sub ddo_switch --split temporal --audience self --bf16 --push
#   sbatch -A <account> jobs/train.sub ddo_switch --audience self --max-length 8192 --bf16 --push
#   sbatch -A <account> jobs/train.sub ddo_switch --eval-only --bf16
#   sbatch -A <account> jobs/train.sub ddo_common --dataset-revision rq2 --init-from outputs/cmv_common --bf16
#   sbatch -A <account> jobs/train.sub ddo_common --dataset-revision rq2 --eval-only outputs/cmv_common --tag by-cmv_common --bf16
# Names starting with t3_ are not dataset configs of scripts/train_delta.py. A T3 training run with
# another seed has -seed<N> too, as scripts/t3/train.py names it (outputs/t3_profiles-seed<N>/); the
# inference script writes to one fixed folder, and no other suffix applies to a t3_ name.
#   sbatch -A <account> jobs/train.sub t3_profiles --seed 43 --bf16 --push
RUN=$CONFIG
SPLIT_SUFFIX=
AUDIENCE_SUFFIX=
RECORD_SUFFIX=
LENGTH_SUFFIX=
INIT_SUFFIX=
TAG_SUFFIX=
SEED_SUFFIX=
previous=
for arg in "$@"; do
    for option in --split --audience --voter-record --max-length --init-from --tag --seed; do
        if [[ $arg == $option=* ]]; then
            previous=$option
            arg=${arg#$option=}
        fi
    done
    if [[ $previous == --split && $arg != random && $CONFIG != t3_* ]]; then
        SPLIT_SUFFIX=-$arg
    fi
    if [[ $previous == --audience && $arg != none ]]; then
        AUDIENCE_SUFFIX=-audience-$arg
    fi
    if [[ $previous == --voter-record && $arg != none && $CONFIG != t3_* ]]; then
        RECORD_SUFFIX=-record-$arg
    fi
    if [[ $previous == --max-length && $arg != 4096 && $CONFIG != t3_* ]]; then
        LENGTH_SUFFIX=-len$arg
    fi
    if [[ $previous == --init-from && $CONFIG != t3_* ]]; then
        # the last part of the model's path or repo, without the prefix of this project's model repos
        INIT_NAME=${arg%/}
        INIT_NAME=${INIT_NAME##*/}
        INIT_SUFFIX=-init-${INIT_NAME#nlp-project-modernbert-}
    fi
    if [[ $previous == --tag && $CONFIG != t3_* ]]; then
        TAG_SUFFIX=-$arg
    fi
    if [[ $previous == --seed && $arg != 42 && $CONFIG != t3_profiles_infer ]]; then
        SEED_SUFFIX=-seed$arg
    fi
    previous=$arg
done
RUN=$CONFIG$SPLIT_SUFFIX$AUDIENCE_SUFFIX$RECORD_SUFFIX$LENGTH_SUFFIX$INIT_SUFFIX$TAG_SUFFIX$SEED_SUFFIX
DONE=outputs/$RUN/DONE
FAILED=outputs/$RUN/FAILED
SMOKE=false
if [[ " $* " == *" --smoke "* || " $* " == *" --eval-only"* ]]; then
    SMOKE=true
fi
if ! $SMOKE && [[ -f $DONE ]]; then
    echo "$RUN already finished ($DONE exists); nothing to do."
    exit 0
fi
if ! $SMOKE && [[ -f $FAILED ]]; then
    echo "An earlier part of this $RUN run crashed ($FAILED exists); see its log, fix the cause, delete $FAILED, and resubmit."
    exit 1
fi

# scripts/train_delta.py calls login(token=$HF_TOKEN); without it the job blocks on an interactive prompt.
: "${HF_TOKEN:?export HF_TOKEN in your shell before running sbatch}"

# Home is capped at 25GB, so the env and HF cache live on scratch
# (run from a clone on scratch too, since checkpoints land in ./outputs/).
export HF_HOME=$RCAC_SCRATCH/hf_cache
PY=$RCAC_SCRATCH/persuasion-env/bin/python

nvidia-smi
# Stop rather than hold a GPU while training on CPU (RCAC tracks per-job GPU utilization).
if ! "$PY" -c "import sys, torch; sys.exit(0 if torch.cuda.is_available() else 'torch cannot use the GPU')" \
    || ! "$PY" "${TRAIN[@]}" "$@"; then
    if ! $SMOKE; then
        mkdir -p "$(dirname "$FAILED")"
        touch "$FAILED"
    fi
    exit 1
fi

if ! $SMOKE; then
    mkdir -p "$(dirname "$DONE")"
    touch "$DONE"
fi
