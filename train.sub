#!/bin/bash
# FILENAME: train.sub
# Slurm job for fine-tuning on Purdue's Gilbreth cluster. Submit from the repo root:
#   sbatch -A <account> train.sub cmv
#   sbatch -A <account> train.sub ddo --push
#   sbatch -A <account> -q normal -t 12:00:00 train.sub cmv   # if your account owns GPUs
# Everything after the config name is passed through to train_delta.py.
# Run `slist` to see your accounts; standby (max 4h) works with any account.
#
# Runs longer than one job: queue several parts up front. Each waits for the previous one
# to end (afterany, since a time-limit kill counts as a failure), resumes from its last
# checkpoint, and parts left over after training finishes exit immediately:
#   jid=$(sbatch --parsable -A <account> train.sub ddo)
#   for i in 1 2 3; do jid=$(sbatch --parsable -A <account> --dependency=afterany:$jid train.sub ddo); done
# To start a config over from scratch, delete outputs/<config>/.
#SBATCH --job-name=persuasion
#SBATCH --partition=a100-80gb
#SBATCH --qos=standby
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --output=%x-%j.out

set -euo pipefail

CONFIG=${1:-cmv}
shift || true

# Marks a finished full run so later parts of a chain skip it; smoke runs never set or check it.
DONE=outputs/$CONFIG/DONE
SMOKE=false
if [[ " $* " == *" --smoke "* ]]; then
    SMOKE=true
fi
if ! $SMOKE && [[ -f $DONE ]]; then
    echo "$CONFIG already finished ($DONE exists); nothing to do."
    exit 0
fi

# train_delta.py calls login(token=$HF_TOKEN); without it the job blocks on an interactive prompt.
: "${HF_TOKEN:?export HF_TOKEN in your shell before running sbatch}"

# Home is capped at 25GB, so the venv and HF cache live on scratch
# (run from a clone on scratch too, since checkpoints land in ./outputs/).
export HF_HOME=$RCAC_SCRATCH/hf_cache
module load anaconda
source "$RCAC_SCRATCH/persuasion-venv/bin/activate"

nvidia-smi
python train_delta.py --dataset-config "$CONFIG" "$@"

if ! $SMOKE; then
    mkdir -p "$(dirname "$DONE")"
    touch "$DONE"
fi
